CONFIG_IDF_TARGET="esp32"

# Typical ESP32 DevKit V1 (30-pin, ESP-WROOM-32) module: 4 MB flash, no PSRAM.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# Wi-Fi access point + HTTP server replace the LCD/touch UI.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_HTTPD_MAX_URI_HANDLERS=24
CONFIG_HTTPD_WS_SUPPORT=n

CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# Bluetooth is unused on this build; disabling it frees RAM for Wi-Fi/HTTP.
CONFIG_BT_ENABLED=n
